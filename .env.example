# Copy to .env (never commit .env). All values are optional; without them Stetho
# runs fully offline with templates, espeak-ng voice and the web/CLI demo.

# --- Storage & privacy ---
STETHO_DATA_DIR=./var
STETHO_RETAIN_MEDIA_HOURS=0          # 0 = delete uploads right after analysis
STETHO_ARTIFACT_TTL_HOURS=24
STETHO_ID_SALT=change-me-to-a-long-random-secret
STETHO_MAX_UPLOAD_MB=64
STETHO_ANALYSIS_TIMEOUT_S=50
STETHO_RESPONSE_TARGET_S=60

# --- Pipeline ---
STETHO_SEGMENTER=auto                # auto | sam3 | centre
STETHO_MAGNIFY=1

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0         # check Meta's docs for the current version

# --- Meta Model API (Muse Spark), OpenAI-compatible ---
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.1       # verify current model ids in Meta's docs
